{{ if .isDarwin -}}
eval "$({{ .brewPrefix }}/bin/brew shellenv)"
export PATH="{{ .brewPrefix }}/opt/coreutils/libexec/gnubin:{{ .brewPrefix }}/opt/gnu-sed/libexec/gnubin:$PATH"
export BROWSER=open
{{- else if not .isServer -}}
export BROWSER=firefox
export QT_QPA_PLATFORMTHEME="qt5ct"
export GTK_THEME=adw-gtk3-dark
{{- end }}
{{ if not .isServer }}
{{- /* Headless boxes inherit TERM from the SSH client; forcing ghostty would
       break ncurses apps, since the server has no ghostty terminfo entry. */}}
export TERM=ghostty
{{- end }}
export EDITOR=nvim
export PATH="$HOME/.local/bin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
{{ if .isLinux }}
{{- /* SSH and tty logins start bash as a login shell, which reads this file and
       never ~/.bashrc — and Linux has no ~/.bash_profile here. Source it last,
       once PATH already includes ~/.local/bin, or the command -v guards in
       .bashrc miss the tools installed there. .bashrc returns early when the
       shell is not interactive, so non-interactive logins are unaffected. */}}
if [ -n "${BASH_VERSION-}" ] && [ -r "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
{{- end }}
