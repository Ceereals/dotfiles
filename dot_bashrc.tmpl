{{ if .isLinux -}}
[[ $- == *i* && -r ~/.local/share/blesh/ble.sh ]] && source ~/.local/share/blesh/ble.sh --noattach

{{ end -}}
[[ $- != *i* ]] && return
{{ if .isDarwin }}
[ -r "{{ .brewPrefix }}/etc/profile.d/bash_completion.sh" ] && . "{{ .brewPrefix }}/etc/profile.d/bash_completion.sh"
{{- end }}
{{- if .hasOmarchy }}
source ~/.local/share/omarchy/default/bash/rc
{{- end }}

command -v bat &>/dev/null && alias cat='bat'
command -v direnv &>/dev/null && eval "$(direnv hook bash)"
{{ if not .hasOmarchy }}
# Debian ships a subset of these tools, so every alias has to survive a missing binary.
if command -v eza &>/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -l --icons --group-directories-first'
    alias la='eza -la --icons --group-directories-first'
else
    alias ll='ls -l'
    alias la='ls -la'
fi
command -v lazygit &>/dev/null && alias lg='lazygit'
{{- if .isServer }}
# Membership in the docker group is root-equivalent, so the login user stays out
# of it; reach the socket through the NOPASSWD sudo it already has. The path is
# resolved now because sudo's secure_path does not include ~/.local/bin.
if command -v lazydocker &>/dev/null; then
    alias lazydocker="sudo -n $(command -v lazydocker)"
    alias ld='lazydocker'
fi
{{- end }}
alias vim='nvim'
{{ if .isDarwin }}alias o='open'{{ else }}alias o='xdg-open'{{ end }}

command -v mise &>/dev/null && eval "$(mise activate bash)"
command -v zoxide &>/dev/null && eval "$(zoxide init --cmd cd bash)"
command -v starship &>/dev/null && eval "$(starship init bash)"
command -v fzf &>/dev/null && eval "$(fzf --bash)"
{{ end }}
[ -r "$HOME/.config/remnic/env" ] && set -a && . "$HOME/.config/remnic/env" && set +a
{{ if .isLinux }}
[[ ! ${BLE_VERSION-} ]] || ble-attach
{{- end }}
