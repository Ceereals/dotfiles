{{- $isLinux  := eq .chezmoi.os "linux" -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $osID     := .chezmoi.os -}}
{{- if and $isLinux (hasKey .chezmoi.osRelease "id") -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}
{{- $isDebian := and $isLinux (eq $osID "linux-debian") -}}
{{- $hasOmarchy := and $isLinux (stat (joinPath .chezmoi.homeDir ".local/share/omarchy") | not | not) -}}
{{- $isGUI := $isDarwin -}}
{{- if $isLinux -}}
{{- /* Only a real graphical session counts: over SSH systemd sets XDG_SESSION_TYPE=tty. */ -}}
{{-   $session := env "XDG_SESSION_TYPE" -}}
{{-   $isGUI = or $hasOmarchy (eq $session "wayland") (eq $session "x11") (ne (env "WAYLAND_DISPLAY") "") -}}
{{- end -}}
{{- /* Headless Linux box: servers get the minimal, apt-only profile.
       The sniffed value is only a proposal — confirm it once at init. The answer
       is stored in [data] below, so later inits reuse it and never ask again.
       With no TTY the default wins, so unattended bootstraps never block;
       preseed with: chezmoi init --promptBool "server headless=true" */ -}}
{{- $isServer := and $isLinux (not $isGUI) -}}
{{- if $isLinux -}}
{{-   $isServer = promptBoolOnce . "isServer" "server headless" $isServer -}}
{{- end -}}
{{- $brewPrefix := "/opt/homebrew" -}}
{{- if and $isDarwin (eq .chezmoi.arch "amd64") -}}
{{-   $brewPrefix = "/usr/local" -}}
{{- end -}}
encryption = ""

[data]
    osid = {{ $osID | quote }}
    isLinux = {{ $isLinux }}
    isDarwin = {{ $isDarwin }}
    isGUI = {{ $isGUI }}
    isDebian = {{ $isDebian }}
    isServer = {{ $isServer }}
    hasOmarchy = {{ $hasOmarchy }}
    brewPrefix = {{ $brewPrefix | quote }}

[data.font]
    family = "JetBrainsMono Nerd Font"
    size = {{ if $isDarwin }}13{{ else }}9{{ end }}

[data.terminal]
    theme = "tokyonight"

[git]
    {{- /* Servers consume dotfiles, they don't author them: never commit/push from there. */}}
    autoCommit = {{ not $isServer }}
    autoPush = {{ not $isServer }}

[diff]
    exclude = ["scripts"]
