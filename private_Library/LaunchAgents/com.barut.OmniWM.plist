<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OmniWM ha un "Start at Login" suo, ma vive in SMAppService: un database
	     di macOS che non si versiona e che si imposta solo dalla GUI. Qui e' un
	     LaunchAgent per lo stesso motivo di KDE Connect - torna su da solo su
	     una macchina nuova. Se un giorno accendi anche il toggle nella GUI,
	     spegni questo: due avvii non rompono nulla ma sono ridondanti. -->
	<key>Label</key>
	<string>com.barut.OmniWM</string>

	<!-- `open` invece del binario diretto: OmniWM e' un'app con status bar e
	     permessi TCC legati all'identita' del bundle. Esce subito, quindi
	     niente KeepAlive. -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-a</string>
		<string>/Applications/OmniWM.app</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
