<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ac-sleep-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ac-sleep-guard.sh</string>
    </array>

    <!-- macOS non espone un trigger launchd per il cambio di alimentazione,
         quindi si sonda. 30s costano nulla ed e' il ritardo massimo prima che
         staccando la spina il sleep torni disponibile. -->
    <key>StartInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/var/log/ac-sleep-guard.err</string>
</dict>
</plist>
