{
  "title": "usit — accenti italiani su Option destro",
  "rules": [
    {
      "description": "Accenti IT su Option destro (à è ì ò ù é) — porta di ~/.config/xkb/symbols/usit",
      "manipulators": [
        {
          "type": "basic",
          "description": "right_option + a -> à",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "right_option"
              ]
            }
          },
          "to": [
            {
              "key_code": "grave_accent_and_tilde",
              "modifiers": [
                "left_option"
              ]
            },
            {
              "key_code": "a"
            }
          ]
        },
        {
          "type": "basic",
          "description": "right_option + shift + a -> À",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "right_option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "grave_accent_and_tilde",
              "modifiers": [
                "left_option"
              ]
            },
            {
              "key_code": "a",
              "modifiers": [
                "left_shift"
              ]
            }
          ]
        },
