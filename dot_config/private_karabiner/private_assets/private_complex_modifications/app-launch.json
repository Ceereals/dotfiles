{
  "title": "Lancio app come su Omarchy",
  "rules": [
    {
      "description": "Option+Shift+lettera lancia le app (OmniWM non ha un'azione 'exec')",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -a 'Google Chrome'" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": ["option", "control"] } },
          "to": [ { "shell_command": "open -na Ghostty --args -e bash -lc 'tmux attach || tmux new -s Work'" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "b", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -a 'Google Chrome'" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "f", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -a Finder" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "n", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -a 'Visual Studio Code'" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "o", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -a Obsidian" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "d", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -na Ghostty --args -e lazydocker" } ]
        },
        {
          "type": "basic",
          "from": { "key_code": "slash", "modifiers": { "mandatory": ["option", "shift"] } },
          "to": [ { "shell_command": "open -a Bitwarden" } ]
        }
      ]
    }
  ]
}
